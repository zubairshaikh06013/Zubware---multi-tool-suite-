/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ChatGPT's sandbox loads the public widget assets across origins.
/chatgpt-plugin/*
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

/chatgpt-plugin/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Internal QA pages must never appear in search results.
/qa/*
  X-Robots-Tag: noindex, nofollow

# A not-found response is not an indexable landing page.
/404.html
  X-Robots-Tag: noindex, nofollow

# Cloudflare redirects /404.html to /404; protect the final URL too.
/404
  X-Robots-Tag: noindex, nofollow

# Public per-tool guide data is revalidated and is not a search landing page.
/tool-seo/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

# Content-hashed self-hosted brand font.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex
