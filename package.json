{
  "name": "zubware-multi-tool-suite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production vite build --mode production",
    "generate:seo": "tsx scripts/generateSeoAndSitemap.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:qr": "tsx scripts/testQrGenerator.ts",
    "test:omr": "tsx scripts/testOmrLayout.ts",
    "prebuild": "node scripts/prepareVideoEngine.mjs",
    "predev": "node scripts/prepareVideoEngine.mjs",
    "postbuild": "node --import tsx scripts/generateSeoAndSitemap.ts && node --import tsx scripts/testCompactContent.ts && node scripts/buildSearchIndex.mjs && node scripts/indexNow.mjs build",
    "audit:lighthouse": "lhci autorun",
    "audit:site": "unlighthouse-ci",
    "audit:links:prepare": "node scripts/prepareAuditLinks.mjs",
    "test:seo-search": "node --import tsx scripts/testSeoSearch.ts",
    "test:indexnow": "node --test scripts/testIndexNow.mjs",
    "test:cgpa": "node --import tsx scripts/testCgpa.ts",
    "test:wedding": "node --import tsx workers/wedding-invitations/test.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@google/genai": "^2.4.0",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/crypto-js": "^4.2.2",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "lodash-es": "4.18.1",
    "lucide-react": "^0.546.0",
    "marked": "^18.1.1",
    "motion": "^12.23.24",
    "ndarray": "1.0.19",
    "omggif": "^1.0.10",
    "onnxruntime-web": "1.21.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/omggif": "^1.0.5",
    "@types/pdfjs-dist": "^2.10.378",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@unlighthouse/cli": "0.19.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pagefind": "1.5.2",
    "puppeteer-core": "25.16.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
