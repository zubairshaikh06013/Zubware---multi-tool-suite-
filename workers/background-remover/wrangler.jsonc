{
  "name": "zubware-background-remover",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "images": {
    "binding": "IMAGES"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  }
}
